(
    version: 1,
    name: "munching_squares",
    components: [
        (id: 1, kind: Text, pos: (0, -9), props: (label: "Munching squares, a classic display hack: a 15-bit counter scans the 32 x 32 screen (x, y) once per")),
        (id: 2, kind: Text, pos: (0, -6), props: (label: "frame t. Pixels with x XOR y < t are drawn in a colour from (x XOR y) + t, the others black.")),
