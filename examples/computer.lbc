(
    version: 1,
    name: "computer",
    components: [
        (id: 1, kind: Text, pos: (0, -20), props: (label: "An 8-bit computer: 16-bit instructions from the program ROM, eight registers (open regfile), an ALU (open alu),")),
        (id: 2, kind: Text, pos: (0, -17), props: (label: "a RAM holding the texts, a keyboard and a terminal; one instruction per rising clock edge. The control ROM")),
        (id: 3, kind: Text, pos: (0, -14), props: (label: "turns each opcode into the control signals, which reach the rest of the machine through tunnels.")),
        (id: 4, kind: Text, pos: (0, -11), props: (label: "It runs a calculator: select the keyboard, type 12+30 or 200-1 and press Enter. Raise the speed to watch it work.")),
