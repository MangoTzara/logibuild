        (id: 1, kind: Text, pos: (0, -30), props: (label: "Conway\'s Game of Life on an 8 x 8 torus. Each register holds a row; each life_row instance")),
        (id: 2, kind: Text, pos: (0, -27), props: (label: "computes the next row from it and its neighbours, which arrive through tunnels r0-r7. Choose")),
        (id: 3, kind: Text, pos: (0, -24), props: (label: "a PATTERN (0 glider, 1 oscillators, 2 R-pentomino, 3 soup) and press LOAD; it is loaded on")),
        (id: 4, kind: Text, pos: (0, -21), props: (label: "the next clock edge, then a generation is computed every edge.")),
